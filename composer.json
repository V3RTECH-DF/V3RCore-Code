{
    "name": "v3rtech/v3r-core",
    "description": "Biblioteca cliente compartilhada de licenciamento e auto-atualização para os plugins WordPress da V3RTECH/RIT",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "V3RTECH",
            "homepage": "https://v3rtech.com.br/"
        }
    ],
    "require": {
        "php": ">=7.4",
        "yahnis-elsts/plugin-update-checker": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wordpress-stubs": "^6.6",
        "brianhenryie/strauss": "^0.19"
    },
    "autoload": {
        "psr-4": {
            "V3R\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "V3R\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "7.4"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "prefix": "php tools/strauss.php",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed/",
            "namespace_prefix": "V3R\\Core\\Vendor\\",
            "classmap_prefix": "V3RCore_Vendor_",
            "constant_prefix": "V3RCORE_VENDOR_",
            "packages": [
                "yahnis-elsts/plugin-update-checker"
            ],
            "override_autoload": {
                "yahnis-elsts/plugin-update-checker": {
                    "classmap": ["Puc/"],
                    "files": ["load-v5p7.php"]
                }
            },
            "delete_vendor_packages": false,
            "include_modified_date": false,
            "include_author": false
        }
    }
}
