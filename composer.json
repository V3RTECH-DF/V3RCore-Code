{
    "name": "v3rtech/v3r-core",
    "description": "Biblioteca cliente compartilhada de licenciamento e auto-atualização para os plugins WordPress da V3RTECH/RIT",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "V3RTECH",
            "homepage": "https://v3rtech.com.br/"
        }
    ],
    "require": {
        "php": ">=8.2",
        "yahnis-elsts/plugin-update-checker": "^5.4"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "paragonie/sodium_compat": "^1.24",
        "php-stubs/wordpress-stubs": "^6.6",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "V3R\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "V3R\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
