# V3RLGPD — perfis e parâmetros da sonda de acesso por pessoa ("antes" da 1.79.0).
USERS="dev-claude claude-operador claude-assinante __anon__"
# Slug principal + os 7 endereços antigos do mapa LEGACY_REDIRECTS (Admin\AdminSPA).
PAGES="v3rlgpd v3rlgpd-auditoria v3rlgpd-ropa v3rlgpd-ripd v3rlgpd-policies v3rlgpd-atendimento v3rlgpd-settings v3rlgpd-docs"
V3R_PROBE_PLUGIN=v3rlgpd
V3R_PROBE_SLUG=v3rlgpd
V3R_PROBE_NS=v3rlgpd/v1,v3r-core/v1/v3rlgpd
V3R_PROBE_CAPS=manage_v3rlgpd,v3rlgpd_license_view,v3rlgpd_license_manage
# Rotas públicas usam __return_true e o limitador fica no handler (não executado): nada a pular além do padrão.
V3R_PROBE_SURFACES=painel,site
V3R_PROBE_NAV_CLASS='V3RTECH\V3RLGPD\Core\Nav\NavigationBootstrap'
V3R_PROBE_SCREENS=v3rlgpd-painel,v3rlgpd-auditoria-detector,v3rlgpd-auditoria-mapa,v3rlgpd-ropa-inventario,v3rlgpd-ropa-forms,v3rlgpd-ropa-assistant,v3rlgpd-ropa-report,v3rlgpd-ripd,v3rlgpd-ripd-editor,v3rlgpd-ripd-assistant,v3rlgpd-policies,v3rlgpd-policies-editor,v3rlgpd-policies-assistant,v3rlgpd-policies-types,v3rlgpd-templates,v3rlgpd-atendimento-consents,v3rlgpd-atendimento-acknowledgements,v3rlgpd-atendimento-dsar,v3rlgpd-atendimento-reports,v3rlgpd-atendimento-incidents,v3rlgpd-atendimento-retention,v3rlgpd-atendimento-dpo-actions,v3rlgpd-dpo-actions-report,v3rlgpd-compliance-report,v3rlgpd-settings,v3rlgpd-onboarding,v3rlgpd-wizard,v3rlgpd-shortcodes
